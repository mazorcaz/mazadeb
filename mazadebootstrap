#!/bin/bash
# mazadebootstrap
VERSION=1.0

# essential packages
PACKAGES=(
	systemd-sysv
	e2fsprogs
	iproute2
	iputils-ping
	sudo
	systemd-resolved
	iwd
	debootstrap
	ssh
	dbus
	vim-tiny
	ed
	locales
	parted
)

# for user environments
USER_PACKAGES=(
	curl
	sway
	foot
	wofi
	grim
	slurp
	wl-clipboard
	swayidle
	swaylock
	wlsunset
	brightnessctl
	pipewire
	pavucontrol
	alsa-utils
	pipewire-alsa
	xdg-desktop-portal
	xdg-desktop-portal-wlr
)

################
# script setup #
################

cleanup() {
	set +e
	echo "[INFO] Cleaning up..."
	umount -R "$TARGET_DIR" 2>/dev/null || true
}
trap cleanup EXIT

echo "[INFO] mazadebootstrap version $VERSION"

# set up shell
set -e

# check root
if [ "$EUID" -ne 0 ]; then
	echo "[FATAL] Not root. Aborting" >&2
	exit 1
fi

# check required tools
REQUIRED_TOOLS=("debootstrap" "chroot" "mount" "umount")
MISSING_TOOLS=()
for tool in "${REQUIRED_TOOLS[@]}"; do
	if ! command -v "$tool" &> /dev/null; then
		MISSING_TOOLS+=("$tool")
	fi
done
if [ ${#MISSING_TOOLS[@]} -ne 0 ]; then
	echo "[FATAL] The following required tools are not installed:" >&2
	echo "[FATAL] ${MISSING_TOOLS[*]}" >&2
	exit 1
fi

# parse args
TARGET_DIR="/mnt/mazadeb"
ROOT_PART=""
EFI_PART=""
HOME_PART=""
SWAP_PART=""
HOSTNAME="mazadeb"
TINY=false
while getopts "r:e:h:s:d:n:t" opt; do
	case ${opt} in
		r) ROOT_PART="$OPTARG" ;;
		e) EFI_PART="$OPTARG" ;;
		h) HOME_PART="$OPTARG" ;;
		s) SWAP_PART="$OPTARG" ;;
		d) TARGET_DIR="$OPTARG" ;;
		n) HOSTNAME="$OPTARG" ;;
		t) TINY=true ;;
		?)
			echo "[FATAL] Invalid options" >&2
			echo "[FATAL] Usage: mazadebootstrap -r <rootpart> [-e <efipart>] [-h <homepart>] [-s <swappart>] [-d <targetdir>] [-n <hostname>] [-t (disable user software)]" >&2
			exit 1
			;;
	esac
done
if [ -z "$ROOT_PART" ]; then
	echo "[FATAL] Root partition required" >&2
	echo "[FATAL] Usage: mazadebootstrap -r <rootpart> [-e <efipart>] [-h <homepart>] [-s <swappart>] [-d <targetdir>] [-n <hostname>] [-t (disable user software)]" >&2
	exit 1
elif [ ! -b "$ROOT_PART" ]; then
	echo "[FATAL] Root partition '$ROOT_PART' is not a block device"
	exit 1
fi
if [ -n "$EFI_PART" ] && [ ! -b "$EFI_PART" ]; then
	echo "[FATAL] EFI partition '$EFI_PART' is not a block device"
	exit 1
fi
if [ -n "$HOME_PART" ] && [ ! -b "$HOME_PART" ]; then
	echo "[FATAL] Home partition '$HOME_PART' is not a block device"
	exit 1
fi
if [ -n "$SWAP_PART" ] && [ ! -b "$SWAP_PART" ]; then
	echo "[FATAL] Swap partition '$SWAP_PART' is not a block device"
	exit 1
fi

###########
# install #
###########

echo "[INFO] Installing targetting $TARGET_DIR"
echo "[INFO] Root partition: $ROOT_PART"
if [ -n "$EFI_PART" ]; then echo "[INFO] EFI partition: $EFI_PART"; fi
if [ -n "$HOME_PART" ]; then echo "[INFO] Home partition: $HOME_PART"; fi
if [ -n "$SWAP_PART" ]; then echo "[INFO] Swap partition: $SWAP_PART"; fi

# mount
shopt -s dotglob
mkdir -p "$TARGET_DIR"
mount "$ROOT_PART" "$TARGET_DIR"
rm -rf "$TARGET_DIR"/* 2>/dev/null || true
echo "[INFO] Mounted root partition"
if [ -n "$EFI_PART" ]; then
	mkdir -p "$TARGET_DIR/boot/efi"
	mount "$EFI_PART" "$TARGET_DIR/boot/efi"
	echo "[INFO] Mounted EFI partition"
	rm -rf "$TARGET_DIR/boot/efi"/* 2>/dev/null || true
fi
if [ -n "$HOME_PART" ]; then
	mkdir -p "$TARGET_DIR/home"
	mount "$HOME_PART" "$TARGET_DIR/home"
	echo "[INFO] Mounted home partition"
	rm -rf "$TARGET_DIR/home"/* 2>/dev/null || true
fi
shopt -u dotglob

# run debootstrap
IFS=","
PKG_LIST="${PACKAGES[*]}"
unset IFS
echo "[INFO] Runnning debootstrap..."
debootstrap \
	--arch=amd64 \
	--variant=minbase \
	--components=main,contrib,non-free,non-free-firmware \
	--include="$PKG_LIST" \
	"stable" \
	"$TARGET_DIR" \
	"https://deb.debian.org/debian"

####################
# configure system #
####################

echo "[INFO] Configuring system..."

echo "[INFO] Setting hostname to $HOSTNAME..."
echo "$HOSTNAME" > "$TARGET_DIR/etc/hostname"

echo "[INFO] Generating /etc/fstab..."

ROOT_UUID=$(blkid -s UUID -o value "$ROOT_PART")
echo "UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1" > "$TARGET_DIR/etc/fstab"

if [ -n "$EFI_PART" ]; then
	EFI_UUID=$(blkid -s UUID -o value "$EFI_PART")
	echo "UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1" >> "$TARGET_DIR/etc/fstab"
fi

if [ -n "$HOME_PART" ]; then
	HOME_UUID=$(blkid -s UUID -o value "$HOME_PART")
	echo "UUID=$HOME_UUID /home ext4 defaults 0 2" >> "$TARGET_DIR/etc/fstab"
fi

if [ -n "$SWAP_PART" ]; then
	SWAP_UUID=$(blkid -s UUID -o value "$SWAP_PART")
	echo "UUID=$SWAP_UUID none swap sw 0 0" >> "$TARGET_DIR/etc/fstab"
fi

echo "[INFO] Configuring systemd-networkd..."

mkdir -p "$TARGET_DIR/etc/systemd/network/"
cat <<EOF > "$TARGET_DIR/etc/systemd/network/25-wired.network"

# Automatically generated by mazadebootstrap $VERSION

[Match]
Name=en*

[Network]
DHCP=yes
EOF
cat <<EOF > "$TARGET_DIR/etc/systemd/network/25-wireless.network"

# Automatically generated by mazadebootstrap $VERSION

[Match]
Name=wlan* wlp*

[Network]
DHCP=yes
EOF

echo "[INFO] Configuring iwd..."

mkdir -p "$TARGET_DIR/etc/iwd"
cat <<EOF >> "$TARGET_DIR/etc/iwd/main.conf"

# Automatically generated by mazadebootstrap $VERSION

[General]
AddressRandomization=network
AddressRandomizationRange=full
EOF

echo "[INFO] Disabling TTY bell..."

mkdir -p "$TARGET_DIR/etc/modprobe.d"
echo "blacklist pcspkr" > "$TARGET_DIR/etc/modprobe.d/nobeep.conf"
echo "set bell-style none" >> "$TARGET_DIR/etc/inputrc"

echo "[INFO] Copying mazadebootstrap to /usr/local/bin..."

mkdir -p "$TARGET_DIR/usr/local/bin"
cp "${BASH_SOURCE[0]}" "$TARGET_DIR/usr/local/bin/mazadebootstrap"
chmod +x "$TARGET_DIR/usr/local/bin/mazadebootstrap"

##########
# chroot #
##########

echo "[INFO] Preparing to chroot..."

mount -B /dev "$TARGET_DIR/dev"
mount -B /dev/pts "$TARGET_DIR/dev/pts"
mount -B /proc "$TARGET_DIR/proc"
mount -B /sys "$TARGET_DIR/sys"

cp -L /etc/resolv.conf "$TARGET_DIR/etc"

echo "[INFO] Chrooting..."
chroot "$TARGET_DIR" /bin/bash <<EOF
export DEBIAN_FRONTEND=noninteractive

# configure locales
echo "[INFO] Configuring locales..."
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

# install things
echo "[INFO] Installing kernel, firmware, and bootloader..."
apt update
apt install -y \
	firmware-iwlwifi \
	firmware-realtek \
	firmware-atheros \
	firmware-brcm80211 \
	firmware-mediatek \
	linux-image-amd64 \
	grub-efi-amd64

if ! $TINY; then
	echo "[INFO] Installing user packages..."
	apt install -y ${USER_PACKAGES[@]}
fi

# install grub
echo "[INFO] Installing grub..."
grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=$HOSTNAME --removable --recheck
update-grub

# configure system
echo "[INFO] Configuring system..."
systemctl enable systemd-networkd systemd-resolved iwd
echo "root:password" | /usr/sbin/chpasswd
chage -d 0 root
EOF

echo "[INFO] Exited chroot"

echo "[INFO] Installation complete."
echo "[INFO] The default password is 'password'."
exit 0

